# ==========================================
# VK Chrono - Настройки приложения
# ==========================================

# Ключ доступа сообщества ВКонтакте (VK Community Token)
# Получение: Сообщество -> Управление -> Работа с API -> Ключи доступа -> Создать ключ (права: Сообщения, Фотографии, Документы)
VK_TOKEN=your_vk_community_access_token_here

# ID вашего сообщества (число без минуса)
# Пример: 123456789
VK_GROUP_ID=123456789

# ID беседы для логирования (число, обычно начинается с 2000000001)
# Если оставить пустым (0), бот будет логировать все беседы, куда он добавлен
TARGET_PEER_ID=0

# API-ключ Google Gemini (для умных сводок дня, недель и месяцев)
# Получение: https://aistudio.google.com/app/apikey
# Если не указан, бот использует умную эвристическую выжимку диалога
GEMINI_API_KEY=

# Модель Gemini для анализа текста
GEMINI_MODEL=gemini-3.6-flash

# Язык генерации сводок:
# ru - всегда писать сводку на русском (даже если сообщения на английском)
# en - писать сводку на английском
# auto - автоматически определять преобладающий язык беседы
SUMMARY_LANGUAGE=ru

# ==========================================
# GitHub Синхронизация (Опционально)
# ==========================================
# Включить авто-выгрузку всех HTML и MD отчетов в GitHub репозиторий: true / false
GITHUB_ENABLED=false

# Токен GitHub (Personal Access Token с правами repo/contents write)
# Получение: GitHub -> Settings -> Developer Settings -> Personal Access Tokens -> Tokens (classic) -> Generate new token (галочка 'repo')
GITHUB_TOKEN=ghp_your_github_token_here

# Репозиторий в формате "username/repo-name" (если его нет, бот создаст его сам!)
GITHUB_REPO=your_username/vk-chat-logs

# Создавать репозиторий приватным (true) или публичным (false)
GITHUB_REPO_PRIVATE=true

# Ветка для коммитов (по умолчанию main)
GITHUB_BRANCH=main

# Папка внутри репозитория, куда сохранять отчеты (по умолчанию reports)
GITHUB_PATH_PREFIX=reports

# ==========================================
# Google Drive интеграция (Сохранение HTML)
# ==========================================
# Включить автоматическую выгрузку .html отчетов в Google Drive (true/false)
GDRIVE_ENABLED=false

# Вариант А: Через API сервисного аккаунта Google (рекомендуется для серверов)
# Путь к json-файлу ключа сервисного аккаунта (например, service_account.json)
GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json
# ID папки на Google Диске (из URL папки: drive.google.com/drive/folders/ID_ПАПКИ)
GDRIVE_FOLDER_ID=

# Вариант Б: Через приложение Google Диск для ПК (если установлено)
# Укажите локальный путь к папке синхронизации (например, G:\My Drive\VK Reports)
GDRIVE_LOCAL_PATH=

# ==========================================
# Уведомления в беседу ВКонтакте (Тихий режим)
# ==========================================
# Отправлять ли сообщение в чат при закрытии дня (по умолчанию false - тихий режим)
NOTIFY_CHAT_ON_DAILY_REPORT=false

# Отправлять ли сообщение в чат при создании месячной сводки (по умолчанию false)
NOTIFY_CHAT_ON_MONTHLY_REPORT=false

# Количество дней для автоматической компиляции в неделю
AUTO_AGGREGATE_DAYS=7

# Пути к папкам с данными
DATA_DIR=data
